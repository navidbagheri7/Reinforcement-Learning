include README.md LICENSE CITATION.cff CONTRIBUTING.md CHANGELOG.md
recursive-include configs *.json
recursive-include docs *.md *.json *.csv *.html
recursive-include notebooks *.md *.ipynb
recursive-include assets *.npz *.json *.png *.pdf *.gif
recursive-include scripts *.py *.html *.js *.md
recursive-include tests *.py
recursive-include results/reference *.json
include legacy/manifest.json
prune legacy/originals
prune .local
prune results/smoke
prune results/reference/control/*/*/checkpoints
recursive-exclude results/reference *.pt *.zip *.npz *.csv
recursive-exclude * __pycache__ *.py[cod]
prune results/reference/neural/*/*/checkpoints
prune results/reference/offline/*/*/*/checkpoints
prune results/reference/tabular/*/checkpoints
prune results/reference/approximation/*/checkpoints
global-exclude *.py[cod]
recursive-include .github *.yml

include requirements-reference.txt

include .gitignore
include .nojekyll
exclude docs/release_artifacts.json

prune results/reference/simulations/*/*/checkpoints

prune results/reference/modern/*/*/checkpoints
